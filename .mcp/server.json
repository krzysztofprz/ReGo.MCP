{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "description": "MCP server integrating REGON API",
  "name": "io.github.krzysztofprz/ReGo.MCP",
  "version": "0.1.0-beta",
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "ReGo.MCP",
      "version": "0.1.0-beta",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": [
        {
          "name": "regonApiKey",
          "value": "${regonApiKey}",
          "description": "REGON API KEY",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/krzysztofprz/ReGo.MCP",
    "source": "github"
  }
}